{
  // Fonts
  "editor.fontFamily": "'0xProto', 'Pretendard GOV Variable', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'liga'",
  "editor.lineHeight": 1.7,
  "terminal.integrated.fontFamily": "'Monaspace Neon NF', Pretendard, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.featureSettings": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'liga'",
  "terminal.integrated.lineHeight": 1.4,
  "debug.console.fontFamily": "'Monaspace Neon NF', Pretendard, Menlo, Monaco, 'Courier New', monospace",
  "debug.console.lineHeight": 1.6,

  // Theme
  "workbench.colorTheme": "Monokai Pro",
  "workbench.iconTheme": "flow-deep",
  "flow-icons.licenseKey": "{{ onepasswordRead "op://Private/Flow Icons/reg_code" }}",
  "window.systemColorTheme": "auto",

  // Editor
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "editor.unicodeHighlight.nonBasicASCII": false,
  "window.zoomLevel": -1,
  "workbench.editor.pinnedTabsOnSeparateRow": true,

  // Languages
  "python.analysis.typeCheckingMode": "standard",
  "dart.previewFlutterUiGuides": true,

  // Tools
  "git.autofetch": true,
  "claudeCode.preferredLocation": "panel"
}
