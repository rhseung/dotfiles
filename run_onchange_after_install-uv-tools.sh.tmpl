#!/bin/sh
# uv-tools.txt 에 적힌 uv tool 을 설치·업그레이드한다.
# 아래 해시 줄이 chezmoi 의 재실행 트리거다.
# list sha256: {{ include "uv-tools.txt" | sha256sum }}

command -v uv >/dev/null || exit 0

list="$HOME/.local/share/chezmoi/uv-tools.txt"
[ -f "$list" ] || exit 0

while IFS= read -r tool; do
  [ -n "$tool" ] && uv tool install --upgrade "$tool"
done < "$list"
