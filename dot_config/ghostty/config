# Font
font-family = "MonoLisaCode"
font-family = "Symbols Nerd Font Mono"
font-family = "Pretendard GOV Variable"
font-size = 11
font-thicken = true
adjust-box-thickness = 1
adjust-cursor-thickness = 1
font-feature = calt, liga, cv01, cv02, cv03, cv04, cv05, cv07, cv08, cv09, cv11, cv12, dlig, ss01, ss13

# Theme
theme = light:sherbet-light,dark:sherbet

# Layout
adjust-cell-height = 15%
window-padding-x = 8

# Cursor
cursor-style = bar
mouse-hide-while-typing = true

# UX
confirm-close-surface = false

# Keybinds
keybind = super+left=previous_tab
keybind = super+right=next_tab

# background
macos-titlebar-style = tabs

background-opacity = 0.85
background-blur = true
